<footer class="bg-navy-dark text-gray-300 pt-16 pb-24 lg:pb-16 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-left">
        <div class="w-48 shrink-0">
          <svg viewBox="0 0 620 210" class="w-full h-auto drop-shadow-md" role="img" aria-label="Logo Galpão Inflável">
            <defs>
              <linearGradient id="goldFooter" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#8B5A00"/>
                <stop offset="45%" stop-color="#F4A300"/>
                <stop offset="100%" stop-color="#FFD166"/>
              </linearGradient>
              <linearGradient id="goldFooterLight" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#FFE29A" stop-opacity="0.95"/>
                <stop offset="100%" stop-color="#F4A300" stop-opacity="0.15"/>
              </linearGradient>
            </defs>
            <path d="M110 116 C145 28, 248 -6, 310 -6 C372 -6, 475 28, 510 116" stroke="url(#goldFooter)" stroke-width="16" fill="none" stroke-linecap="round"/>
            <path d="M122 108 C154 38, 252 10, 310 10 C368 10, 466 38, 498 108" stroke="url(#goldFooterLight)" stroke-width="4" fill="none" stroke-linecap="round" opacity="0.9"/>
            <path d="M154 116 C182 52, 260 28, 310 28 C360 28, 438 52, 466 116" stroke="url(#goldFooter)" stroke-width="13" fill="none" stroke-linecap="round"/>
            <path d="M164 110 C190 60, 262 38, 310 38 C358 38, 430 60, 456 110" stroke="url(#goldFooterLight)" stroke-width="3" fill="none" stroke-linecap="round" opacity="0.9"/>
            <path d="M198 116 C218 72, 272 56, 310 56 C348 56, 402 72, 422 116" stroke="url(#goldFooter)" stroke-width="11" fill="none" stroke-linecap="round"/>
            <path d="M206 112 C224 78, 274 64, 310 64 C346 64, 396 78, 414 112" stroke="url(#goldFooterLight)" stroke-width="2.5" fill="none" stroke-linecap="round" opacity="0.9"/>
            <path d="M124 132 Q310 150 496 132" stroke="url(#goldFooter)" stroke-width="7" fill="none" stroke-linecap="round"/>
            <path d="M205 116 Q202 126 201 138" stroke="#FFD166" stroke-width="2.2" opacity="0.65" fill="none" stroke-linecap="round"/>
            <path d="M250 116 Q248 128 247 142" stroke="#FFD166" stroke-width="2.2" opacity="0.65" fill="none" stroke-linecap="round"/>
            <path d="M310 116 Q310 130 310 146" stroke="#FFD166" stroke-width="2.4" opacity="0.75" fill="none" stroke-linecap="round"/>
            <path d="M370 116 Q372 128 373 142" stroke="#FFD166" stroke-width="2.2" opacity="0.65" fill="none" stroke-linecap="round"/>
            <path d="M415 116 Q418 126 419 138" stroke="#FFD166" stroke-width="2.2" opacity="0.65" fill="none" stroke-linecap="round"/>
            <text x="50%" y="188" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="38" font-weight="bold" letter-spacing="0.5">
              <tspan fill="#ffffff">GALPAO</tspan>
              <tspan fill="url(#goldFooter)">INFLAVEL</tspan>
              <tspan fill="#ffffff">.COM</tspan>
            </text>
          </svg>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-white mb-3">Galpão Inflável</h2>
          <p class="text-gray-400 text-sm leading-relaxed max-w-sm mx-auto sm:mx-0">
            Locação de galpão inflável com atendimento profissional, rapidez comercial e foco em solução para operações que não podem parar.
          </p>
        </div>
      </div>
      
      <div class="flex justify-center md:justify-end gap-x-6 gap-y-4 flex-wrap">
        <a href="#inicio" class="text-gray-400 hover:text-gold transition-colors font-medium">Início</a>
        <a href="#urgencia" class="text-gray-400 hover:text-gold transition-colors font-medium">Urgência</a>
        <a href="#beneficios" class="text-gray-400 hover:text-gold transition-colors font-medium">Benefícios</a>
        <a href="#aplicacoes" class="text-gray-400 hover:text-gold transition-colors font-medium">Aplicações</a>
        <a href="#galeria" class="text-gray-400 hover:text-gold transition-colors font-medium">Galeria</a>
        <a href="#faq" class="text-gray-400 hover:text-gold transition-colors font-medium">Dúvidas</a>
      </div>
    </div>
    
    <div class="mt-12 pt-8 border-t border-white/10 text-center text-sm text-gray-500 flex flex-col md:flex-row justify-between items-center gap-4">
      <p>&copy; {new Date().getFullYear()} Galpão Inflável. Todos os direitos reservados.</p>
      <p>Desenvolvido para máxima performance.</p>
    </div>
  </div>
</footer>
