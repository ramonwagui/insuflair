---
const whatsappLink = "https://wa.me/5511941880355?text=Olá,%20quero%20solicitar%20um%20orçamento%20de%20galpão%20inflável.";
---

<div class="bg-gradient-to-r from-gold to-gold-light text-navy-dark py-2 px-4 text-sm font-medium">
  <div class="max-w-7xl mx-auto flex flex-wrap justify-center md:justify-between items-center gap-4 text-center">
    <div class="flex items-center gap-4">
      <a href="tel:+5511941880355" class="hover:text-white transition-colors duration-300">📞 +55 11 94188-0355</a>
      <span class="hidden md:inline">|</span>
      <a href="mailto:comercial@galpaoinflavel.com" class="hover:text-white transition-colors duration-300">✉ comercial@galpaoinflavel.com</a>
    </div>
    <div class="hidden md:block">📍 São Paulo - SP - Brasil</div>
  </div>
</div>

<header class="sticky top-0 z-50 bg-navy/95 backdrop-blur-md shadow-lg border-b border-white/10 transition-all duration-300" id="main-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-24">
      <!-- Logo -->
      <a href="#inicio" class="flex-shrink-0 group" aria-label="Galpão Inflável">
        <svg viewBox="0 0 620 170" class="w-48 sm:w-56 h-auto drop-shadow-md group-hover:scale-105 transition-transform duration-300" role="img" aria-label="Logo Galpão Inflável">
          <defs>
            <linearGradient id="goldHeader" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#8B5A00"/>
              <stop offset="45%" stop-color="#F4A300"/>
              <stop offset="100%" stop-color="#FFD166"/>
            </linearGradient>
            <linearGradient id="goldLight" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#FFE29A" stop-opacity="0.95"/>
              <stop offset="100%" stop-color="#F4A300" stop-opacity="0.15"/>
            </linearGradient>
            <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#f4a300" flood-opacity="0.25"/>
            </filter>
          </defs>
          <path d="M118 84 C150 18, 250 -6, 310 -6 C370 -6, 470 18, 502 84" stroke="url(#goldHeader)" stroke-width="14" fill="none" stroke-linecap="round" filter="url(#softGlow)"/>
          <path d="M128 79 C158 24, 252 4, 310 4 C368 4, 462 24, 492 79" stroke="url(#goldLight)" stroke-width="4" fill="none" stroke-linecap="round" opacity="0.9"/>
          <path d="M160 84 C185 35, 260 16, 310 16 C360 16, 435 35, 460 84" stroke="url(#goldHeader)" stroke-width="12" fill="none" stroke-linecap="round"/>
          <path d="M168 80 C192 40, 262 24, 310 24 C358 24, 428 40, 452 80" stroke="url(#goldLight)" stroke-width="3" fill="none" stroke-linecap="round" opacity="0.9"/>
          <path d="M202 84 C220 52, 273 40, 310 40 C347 40, 400 52, 418 84" stroke="url(#goldHeader)" stroke-width="10" fill="none" stroke-linecap="round"/>
          <path d="M208 81 C224 56, 274 47, 310 47 C346 47, 396 56, 412 81" stroke="url(#goldLight)" stroke-width="2.5" fill="none" stroke-linecap="round" opacity="0.9"/>
          <path d="M132 98 Q310 118 488 98" stroke="url(#goldHeader)" stroke-width="6" fill="none" stroke-linecap="round"/>
          <path d="M208 84 Q205 92 204 100" stroke="#FFD166" stroke-width="2.2" opacity="0.65" fill="none" stroke-linecap="round"/>
          <path d="M250 84 Q248 94 247 104" stroke="#FFD166" stroke-width="2.2" opacity="0.65" fill="none" stroke-linecap="round"/>
          <path d="M310 84 Q310 96 310 108" stroke="#FFD166" stroke-width="2.4" opacity="0.75" fill="none" stroke-linecap="round"/>
          <path d="M370 84 Q372 94 373 104" stroke="#FFD166" stroke-width="2.2" opacity="0.65" fill="none" stroke-linecap="round"/>
          <path d="M412 84 Q415 92 416 100" stroke="#FFD166" stroke-width="2.2" opacity="0.65" fill="none" stroke-linecap="round"/>
          <text x="50%" y="148" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="34" font-weight="bold" letter-spacing="0.5">
            <tspan fill="#ffffff">GALPAO</tspan>
            <tspan fill="url(#goldHeader)">INFLAVEL</tspan>
            <tspan fill="#ffffff">.COM</tspan>
          </text>
        </svg>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex space-x-8">
        <a href="#inicio" class="text-white hover:text-gold transition-colors font-medium text-sm uppercase tracking-wide">Início</a>
        <a href="#urgencia" class="text-white hover:text-gold transition-colors font-medium text-sm uppercase tracking-wide">Urgência</a>
        <a href="#beneficios" class="text-white hover:text-gold transition-colors font-medium text-sm uppercase tracking-wide">Benefícios</a>
        <a href="#aplicacoes" class="text-white hover:text-gold transition-colors font-medium text-sm uppercase tracking-wide">Aplicações</a>
        <a href="#galeria" class="text-white hover:text-gold transition-colors font-medium text-sm uppercase tracking-wide">Galeria</a>
        <a href="#faq" class="text-white hover:text-gold transition-colors font-medium text-sm uppercase tracking-wide">Dúvidas</a>
      </nav>

      <!-- CTA Button -->
      <div class="hidden lg:block">
        <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-full shadow-lg text-sm font-bold text-navy-dark bg-gradient-to-r from-gold to-gold-light hover:scale-105 hover:shadow-gold/30 transition-all duration-300">
          Solicitar Orçamento
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="lg:hidden flex items-center">
        <button id="mobile-menu-btn" class="text-white hover:text-gold focus:outline-none focus:text-gold p-2">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden bg-navy-dark/95 backdrop-blur-lg border-t border-white/10">
    <div class="px-4 pt-2 pb-6 space-y-1">
      <a href="#inicio" class="block px-3 py-3 rounded-md text-base font-medium text-white hover:text-gold hover:bg-white/5 transition-colors">Início</a>
      <a href="#urgencia" class="block px-3 py-3 rounded-md text-base font-medium text-white hover:text-gold hover:bg-white/5 transition-colors">Urgência</a>
      <a href="#beneficios" class="block px-3 py-3 rounded-md text-base font-medium text-white hover:text-gold hover:bg-white/5 transition-colors">Benefícios</a>
      <a href="#aplicacoes" class="block px-3 py-3 rounded-md text-base font-medium text-white hover:text-gold hover:bg-white/5 transition-colors">Aplicações</a>
      <a href="#galeria" class="block px-3 py-3 rounded-md text-base font-medium text-white hover:text-gold hover:bg-white/5 transition-colors">Galeria</a>
      <a href="#faq" class="block px-3 py-3 rounded-md text-base font-medium text-white hover:text-gold hover:bg-white/5 transition-colors">Dúvidas</a>
      <a href={whatsappLink} target="_blank" class="block w-full mt-4 text-center px-6 py-3 rounded-full shadow-lg text-base font-bold text-navy-dark bg-gradient-to-r from-gold to-gold-light">
        Solicitar Orçamento
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const links = menu?.querySelectorAll('a');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  links?.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>
