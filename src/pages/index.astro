---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';

const whatsappLink = "https://wa.me/5511941880355?text=Olá,%20quero%20solicitar%20um%20orçamento%20de%20galpão%20inflável.";
---

<Layout 
  title="Galpão Inflável | Cobertura Rápida para Obras, Logística e Indústria"
  description="Locação de galpão inflável com montagem rápida para obras, armazenagem, logística, indústria e mineração. Solicite orçamento imediato."
>
  <Header />

  <main id="conteudo" tabindex="-1" class="flex-grow">
    <!-- Hero Section -->
    <section id="inicio" class="relative min-h-[90vh] flex items-center justify-center bg-navy-dark overflow-hidden">
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img src="/assets/hero-galpao.jpg" alt="" class="w-full h-full object-cover opacity-40" />
        <div class="absolute inset-0 bg-gradient-to-r from-navy-dark via-navy/80 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-navy-dark via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-20 grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 text-white">
          <div class="inline-block px-4 py-2 rounded-full bg-gold/20 border border-gold/30 text-gold-light font-semibold text-sm mb-6 backdrop-blur-sm animate-fade-in-up">
            Montagem rápida • Atendimento imediato
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-6 drop-shadow-lg">
            Galpão inflável para obras, logística e <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold to-gold-light">operações que não podem parar</span>
          </h1>
          
          <p class="text-lg md:text-xl text-gray-300 mb-8 max-w-2xl leading-relaxed drop-shadow-md">
            Solução rápida para cobrir áreas, proteger materiais, manter a operação ativa e reduzir prejuízos. Atendimento ágil para orçamento em todo o Brasil.
          </p>
          
          <div class="flex flex-wrap gap-4 mb-8">
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold rounded-full text-white bg-green-700 hover:bg-green-800 shadow-lg transition-all duration-300">
              Orçamento no WhatsApp
            </a>
            <a href="#galeria" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold rounded-full text-white bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur-md transition-all duration-300">
              Ver Projetos Reais
            </a>
          </div>

          <div class="flex flex-wrap gap-3 text-sm font-medium">
            <span class="flex items-center gap-2 bg-white/10 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/10"><span class="text-green-400">✔</span> Cobertura para obra</span>
            <span class="flex items-center gap-2 bg-white/10 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/10"><span class="text-green-400">✔</span> Proteção UV/Chuva</span>
            <span class="flex items-center gap-2 bg-white/10 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/10"><span class="text-green-400">✔</span> Montagem ágil</span>
          </div>
        </div>

        <div class="lg:col-span-5 hidden lg:block">
          <div class="glass-panel rounded-3xl p-8 transform hover:-translate-y-2 transition-transform duration-500">
            <h2 class="text-2xl font-bold text-white mb-4">Precisa de cobertura urgente?</h2>
            <p class="text-gray-300 mb-6 text-sm">Fale com nossa equipe e receba orientação para escolher a melhor solução.</p>
            <ul class="space-y-4 mb-8">
              <li class="flex items-start gap-3 text-sm text-gray-200">
                <span class="text-green-400 font-bold mt-0.5">✔</span>
                Ideal para obras, logística e indústria
              </li>
              <li class="flex items-start gap-3 text-sm text-gray-200">
                <span class="text-green-400 font-bold mt-0.5">✔</span>
                Protege materiais, máquinas e equipes
              </li>
              <li class="flex items-start gap-3 text-sm text-gray-200">
                <span class="text-green-400 font-bold mt-0.5">✔</span>
                Excelente para expansão rápida
              </li>
            </ul>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="block w-full text-center px-6 py-4 rounded-full font-bold text-navy-dark bg-gradient-to-r from-gold to-gold-light hover:shadow-lg hover:shadow-gold/30 transition-all duration-300">
              Atendimento no WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Urgência Section -->
    <section id="urgencia" class="py-20 lg:py-28 bg-gradient-to-b from-red-50 to-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">Sua operação está exposta ou sem cobertura?</h2>
          <p class="text-lg text-gray-600">Quando falta estrutura temporária, o prejuízo pode vir em forma de atraso, perda de material e improviso.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-red-100 border border-red-200 rounded-3xl p-8 hover:-translate-y-2 transition-transform duration-300 shadow-sm hover:shadow-md">
            <h3 class="text-xl font-bold text-red-900 mb-3">Obra parada custa caro</h3>
            <p class="text-red-800/80">Atrasos por chuva, falta de cobertura e proteção inadequada podem comprometer cronograma, equipe e produtividade.</p>
          </div>
          <div class="bg-red-100 border border-red-200 rounded-3xl p-8 hover:-translate-y-2 transition-transform duration-300 shadow-sm hover:shadow-md">
            <h3 class="text-xl font-bold text-red-900 mb-3">Material exposto gera perda</h3>
            <p class="text-red-800/80">Equipamentos, insumos e estoques sem cobertura ficam vulneráveis a chuva, sol excessivo, sujeira e deterioração.</p>
          </div>
          <div class="bg-red-100 border border-red-200 rounded-3xl p-8 hover:-translate-y-2 transition-transform duration-300 shadow-sm hover:shadow-md">
            <h3 class="text-xl font-bold text-red-900 mb-3">Improviso passa imagem ruim</h3>
            <p class="text-red-800/80">Operações importantes exigem solução profissional, rápida e visualmente adequada para transmitir mais confiança.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefícios Section -->
    <section id="beneficios" class="py-20 lg:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">Por que escolher nosso galpão inflável?</h2>
          <p class="text-lg text-gray-600">Uma solução comercial e operacional para empresas que precisam de rapidez, proteção e boa apresentação.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            [
              { title: "Montagem Rápida", desc: "Indicada para cenários em que o tempo é decisivo e a operação precisa continuar sem demora." },
              { title: "Proteção Eficiente", desc: "Ajuda a proteger materiais, equipamentos e áreas operacionais contra chuva e sol." },
              { title: "Alta Versatilidade", desc: "Pode ser usada em armazenagem, obras, indústria, mineração, logística e mais." },
              { title: "Visual Profissional", desc: "Estrutura com excelente apresentação para operações que precisam de solução prática." },
              { title: "Atendimento Ágil", desc: "Suporte rápido para entender seu cenário, alinhar a necessidade e orçar." },
              { title: "Mais Resultado", desc: "Mais organização, proteção de ativos, melhor uso do espaço e mais eficiência." }
            ].map(benefit => (
              <div class="group bg-white border border-gray-200 rounded-3xl p-8 hover:border-gold hover:shadow-2xl transition-all duration-300">
                <div class="w-12 h-12 bg-gold/10 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-gold group-hover:text-white transition-colors">
                  <svg class="w-6 h-6 text-gold group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-navy mb-3">{benefit.title}</h3>
                <p class="text-gray-600 leading-relaxed">{benefit.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="py-16 bg-navy-dark text-white" aria-labelledby="orcamento-titulo">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="orcamento-titulo" class="text-3xl font-bold mb-4">O que informar para solicitar seu orçamento</h2>
        <p class="text-gray-300 mb-8 max-w-3xl">Reúna os dados da sua operação para conversar com a equipe sobre a estrutura e a locação.</p>
        <dl class="grid md:grid-cols-3 gap-8">
          <div><dt class="text-xl font-bold text-gold-light mb-2">Local e aplicação</dt><dd class="text-gray-300">Informe a cidade e o que precisa cobrir: materiais, equipamentos ou uma área de trabalho.</dd></div>
          <div><dt class="text-xl font-bold text-gold-light mb-2">Área e acesso</dt><dd class="text-gray-300">Envie as medidas aproximadas do espaço e, se possível, fotos do local e dos acessos.</dd></div>
          <div><dt class="text-xl font-bold text-gold-light mb-2">Data e período</dt><dd class="text-gray-300">Indique quando precisa da cobertura e por quanto tempo pretende utilizá-la.</dd></div>
        </dl>
        <p class="text-gray-300 mt-8">Consulte a equipe para confirmar dimensões disponíveis, condições de instalação e prazos para seu local.</p>
      </div>
    </section>

    <!-- Aplicações Section -->
    <section id="aplicacoes" class="py-20 lg:py-28 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">Aplicações Mais Comuns</h2>
          <p class="text-lg text-gray-600">O galpão inflável é uma solução eficiente para diferentes setores.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 flex gap-6 hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 shrink-0 bg-navy/5 rounded-2xl flex items-center justify-center text-3xl">📦</div>
            <div>
              <h3 class="text-xl font-bold text-navy mb-2">Armazenamento Temporário</h3>
              <p class="text-gray-600">Indicado para excesso de estoque, sazonalidade, proteção de materiais e ampliação rápida de área.</p>
            </div>
          </div>
          <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 flex gap-6 hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 shrink-0 bg-navy/5 rounded-2xl flex items-center justify-center text-3xl">🏗️</div>
            <div>
              <h3 class="text-xl font-bold text-navy mb-2">Obras e Construção</h3>
              <p class="text-gray-600">Ajuda a proteger insumos, equipamentos, equipes e áreas de apoio durante fases da obra.</p>
            </div>
          </div>
          <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 flex gap-6 hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 shrink-0 bg-navy/5 rounded-2xl flex items-center justify-center text-3xl">🏭</div>
            <div>
              <h3 class="text-xl font-bold text-navy mb-2">Mineração e Indústria</h3>
              <p class="text-gray-600">Estrutura útil para armazenagem e apoio logístico temporário em ambientes industriais.</p>
            </div>
          </div>
          <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 flex gap-6 hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 shrink-0 bg-navy/5 rounded-2xl flex items-center justify-center text-3xl">🚚</div>
            <div>
              <h3 class="text-xl font-bold text-navy mb-2">Logística e Operações Especiais</h3>
              <p class="text-gray-600">Alternativa prática para cobertura de grande porte com montagem rápida e ótima apresentação.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Galeria Section -->
    <section id="galeria" class="py-20 lg:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">Galeria de Projetos</h2>
          <p class="text-lg text-gray-600">Veja algumas de nossas instalações reais pelo Brasil.</p>
        </div>

        <Gallery />
      </div>
    </section>

    <!-- CTA Section -->
    <section class="relative py-24 bg-navy-dark overflow-hidden">
      <div class="absolute inset-0">
        <img src="/assets/hero-galpao.jpg" class="w-full h-full object-cover opacity-20" alt="" />
        <div class="absolute inset-0 bg-gradient-to-t from-navy-dark to-transparent"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-6">Precisa cobrir sua obra ou estoque com rapidez?</h2>
        <p class="text-xl text-gray-300 mb-10">Entre em contato agora e receba atendimento comercial imediato.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="px-8 py-4 text-lg font-bold rounded-full text-white bg-green-700 hover:bg-green-800 shadow-lg shadow-green-500/30 transition-all hover:-translate-y-1">
            Solicitar Orçamento no WhatsApp
          </a>
          <a href="tel:+5511941880355" class="px-8 py-4 text-lg font-bold rounded-full text-navy-dark bg-gold hover:bg-gold-light shadow-lg shadow-gold/30 transition-all hover:-translate-y-1">
            Ligar Agora
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="py-20 lg:py-28 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">Dúvidas Frequentes</h2>
          <p class="text-lg text-gray-600">Respostas rápidas para as perguntas mais comuns.</p>
        </div>

        <div class="space-y-4">
          {
            [
              { q: "Para quais situações o galpão inflável é indicado?", a: "É indicado para armazenagem temporária, apoio a obras, logística, indústria, mineração, proteção de materiais e operações especiais." },
              { q: "O galpão inflável ajuda a proteger contra chuva e sol?", a: "Sim. Ele é pensado para oferecer cobertura temporária e ajudar na proteção de materiais e equipamentos contra as intempéries climáticas." },
              { q: "Vocês atendem somente São Paulo?", a: "Não. Atendemos São Paulo e diferentes regiões do Brasil, enviando a estrutura conforme a necessidade da operação." },
              { q: "Como solicitar orçamento?", a: "Entre em contato pelo WhatsApp ou telefone. Informe cidade, uso pretendido, medidas aproximadas da área, data desejada e período de locação. Fotos do local e dos acessos ajudam a explicar sua necessidade." },
              { q: "Como confirmar as dimensões e as condições de instalação?", a: "Converse com a equipe sobre o espaço disponível e os acessos ao local. Confirme as dimensões da estrutura, as condições de instalação e os prazos antes de definir a locação." },
              { q: "Essa solução serve para operação temporária?", a: "Sim. O galpão inflável é excelente para demandas temporárias, emergenciais, expansão de área coberta e apoio logístico." }
            ].map(faq => (
              <details class="group bg-white rounded-2xl border border-gray-200 overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-lg text-navy hover:text-gold transition-colors">
                  {faq.q}
                  <span class="ml-6 flex-shrink-0">
                    <svg class="w-6 h-6 text-gray-400 group-open:-rotate-180 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="p-6 pt-0 text-gray-600 leading-relaxed border-t border-gray-100">
                  {faq.a}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

  </main>

  <Footer />

  <!-- Floating WhatsApp Button -->
  <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="fixed bottom-6 right-6 z-50 bg-green-700 text-white p-4 rounded-full shadow-2xl hover:bg-green-800 hover:scale-110 transition-all duration-300 flex items-center justify-center group" aria-label="Falar no WhatsApp">
    <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
    </svg>
    <span class="absolute right-full mr-4 bg-navy text-white text-sm px-3 py-1.5 rounded shadow-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
      Solicitar Orçamento
    </span>
  </a>
</Layout>
